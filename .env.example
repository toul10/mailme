# MailMe configuration. `pnpm run setup` (or ./scripts/docker-setup.sh) writes .env from this file for you;
# to do it by hand, copy it to .env and fill it in. Never commit .env.
# src/config.ts is the schema (defaults shown here). Optional keys are commented out: an empty value
# (KEY=) is NOT "unset" and fails validation for URL/secret keys — leave them commented instead.
# The API, the worker and the CLI load ./.env themselves; variables already set in the environment win.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# fatal | error | warn | info | debug | trace   (logs never contain subjects, bodies or addresses)
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# postgres://user:password@host:5432/mailme. A local Postgres with your login user needs no password (the setup
# creates the database). Embedded alternative without a server: pglite://./data/pglite — one process at a time,
# so no worker next to the API: for a look around only.
DATABASE_URL=postgres://localhost:5432/mailme

# ── Web / API ────────────────────────────────────────────────────────────────
# Public base URL of the web app, used in setup and report links. Anything but http://localhost needs HTTPS
# (the sign-in cookie is Secure).
APP_BASE_URL=http://localhost:3000
PORT=3000
# 127.0.0.1 for a local install (a proxy on the same machine reaches it); Docker sets 0.0.0.0 (behind Caddy).
HOST=127.0.0.1

# ── Secrets (the setup generates them; or: pnpm cli secrets:generate) ───────
# 32 random bytes, base64. Encrypts API-side secrets (TOTP seeds). NOT used for mailbox passwords.
# Changing it later means everyone sets up two-step sign-in again.
MASTER_KEY=
# ≥ 32 characters. Session cookies.
APP_SECRET=
# ≥ 32 characters. Signs one-click report links; if unset it is derived from APP_SECRET.
# LINK_SECRET=

# ── Mailbox credential sealing (pnpm cli keys:generate) ─────────────────────
# X25519 sealed box: the API seals with the public key; only the worker (and the CLI on the same machine)
# holds the private key. Keep the private key out of backups, git and the API container.
CREDENTIALS_KID=k1
CREDENTIALS_PUBLIC_KEY_FILE=./data/keys/credentials.pub.pem
CREDENTIALS_PRIVATE_KEY_FILE=./data/keys/credentials.key.pem

# ── AI (Claude, OpenAI, Gemini or Grok) ─────────────────────────────────────
# auto   = a platform admin chooses the provider, the model and the key in Admin → AI. With no AI chosen there:
#          Claude when ANTHROPIC_API_KEY is set below; with no key either, the free mock runs. Once a provider is
#          chosen, a missing key pauses AI until it is fixed.
# mock   = the kill switch: AI is off whatever Admin → AI says, and the worker calls no AI provider at all (not
#          even to list models). Simple built-in rules, no network, rough results.
# claude = older .env files: like auto, but with no AI chosen it means Claude, so AI pauses without ANTHROPIC_API_KEY.
# With AI on, the mail text is processed by the provider you choose (it costs money there).
AI_MODE=auto
# Optional keys from the environment, read by the worker only (Docker blanks them for the API). For the chosen
# provider, a key here wins over one typed in Admin → AI. Most installs leave these out and paste the key in
# Admin → AI. Either way, set a spending limit at the provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# Claude's model when none is chosen in Admin → AI (an ANTHROPIC_API_KEY above, no choice saved).
AI_MODEL=claude-opus-5
# Claude only: low | medium | high | xhigh | max
AI_EFFORT=high
# Gemini only: how hard the model thinks (minimal | low | medium | high | xhigh), billed as output. Unset = the
# model's own default. Models differ in the levels they accept: check with `pnpm cli ai:check` after setting it.
# GEMINI_THINKING_LEVEL=
# Claude only: default = server-side refusal fallbacks on · off
AI_FALLBACKS=default
# Claude only: prompt-cache TTL of the system prompt: 1h live (calls minutes apart), 5m for backfill bursts.
AI_CACHE_TTL=1h
AI_MAX_TOKENS=16000
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=2
# Claude only: true = keep enum/const in the JSON schema sent to the API.
AI_STRICT_ENUMS=false
# Per-mailbox daily caps (overridable per mailbox), for every provider. Reaching one pauses AI for that mailbox
# until local midnight. OpenAI reports no price, so its cost is counted high: $10 per million input tokens and $50
# per million output tokens. Gemini is counted from Google's published prices (src/ai/pricing.ts), and at the same
# high rate for a model that is not in that table.
# `pnpm cli ai:check` sends one invented email through the AI in use: key, billing, model and schema in one call.
AI_DAILY_CALL_CAP=150
AI_DAILY_USD_CAP=10

# ── Chat: "Ask your mail" (API process only; docs/INSTALL.md § Ask your mail) ─
# off (the default) | gemini | mock. A signed-in user asks about their own mail and tasks and gets an answer that
# names the messages it was taken from. It only reads.
# gemini = the Gemini API with CHAT_API_KEY and CHAT_MODEL below (the chat works with Gemini only, whatever
#          provider reads the mail). The API process then holds an AI key, and what a question finds in the user's
#          mail goes to Google: read docs/INSTALL.md § Ask your mail before turning it on.
# mock   = answers from keywords and calls nobody (development).
# `pnpm cli chat:check` asks one invented question over an invented mailbox: key, billing, model, speed and cost.
CHAT_MODE=off
# The chat's own key, read by the API only (Docker blanks it for the worker and the migrations). It is not
# GEMINI_API_KEY above, which is the worker's. Give the chat a key of its own, so that it can be revoked alone,
# and set a spending limit at the provider.
# CHAT_API_KEY=
# CHAT_MODEL=gemini-3.8-flash
# minimal | low | medium | high | xhigh; unset = the model's own default. A question takes several model calls
# (five at most), so the level decides how long the reader waits: compare with `pnpm cli chat:check`.
# CHAT_THINKING_LEVEL=low
# CHAT_MAX_TOKENS=8192
# Questions per user and day (their time zone); dollars per day for all users together (src/ai/pricing.ts rates).
# CHAT_DAILY_QUESTION_CAP=100
# CHAT_DAILY_USD_CAP=3

# ── Mail sync ────────────────────────────────────────────────────────────────
SYNC_INTERVAL_SEC=120
# STATUS poll of the non-INBOX folders (INBOX uses IDLE).
FOLDER_POLL_SEC=300
# A message is analysed only once it has been known this long (late Sent copies from Outlook/phone).
SETTLE_SEC=180
# Larger messages are fetched as headers + text parts only.
MAX_FETCH_BYTES=5242880
# History analysed on first connection (days, max 90).
BACKFILL_DAYS=21
# After go-live, a message first seen with a date older than this is stored as skipped_old (never sent to AI).
LATE_DISCOVERY_MAX_DAYS=7

# ── Retention ────────────────────────────────────────────────────────────────
# Message text/HTML, segments and extraction text.
BODY_RETENTION_DAYS=90
# Closed/dismissed tasks and their evidence (12–24 months).
CLOSED_TASK_RETENTION_DAYS=540

# ── Monitoring ───────────────────────────────────────────────────────────────
# Alerts over a channel independent of the mail server: an ntfy topic URL (plain text + Title/Priority headers)
# or any JSON webhook. Credentials may be embedded (https://user:pass@ntfy.example/topic).
# ALERT_WEBHOOK_URL=https://ntfy.sh/<long-random-topic>
# External dead-man's switch pinged after each full sync cycle and each report (e.g. healthchecks.io).
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>

# ── Mail identity & locale ───────────────────────────────────────────────────
# Domain of the platform's own Message-IDs (loop prevention: its reports are never read back as tasks).
PLATFORM_MAIL_DOMAIN=mailme.local
DEFAULT_TIMEZONE=Europe/Athens
# TOTP for web logins. false only for local development.
AUTH_REQUIRE_MFA=true

# ── Ops (worker / CLI; read by src/ops/env.ts) ──────────────────────────────
# Data directory: audit exports, previews, backups. Its filesystem is watched by the disk check (> 80%).
DATA_DIR=./data
# Written by `pnpm cli backup:dump`; the health check alerts when it is older than 26 h. Unset = no backup check.
# BACKUP_MARKER_FILE=./data/backups/last-backup.json
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30

# ── Docker Compose only ──────────────────────────────────────────────────────
# POSTGRES_PASSWORD=
# MAILME_DOMAIN=mailme.example.com
# ACME_EMAIL=you@example.com
# The compose network: its subnet, the range the other containers get addresses from, and Caddy's fixed address.
# docker-compose.yml sets the api's TRUST_PROXY to Caddy's address (overriding the TRUST_PROXY line below), so only
# Caddy's X-Forwarded-For is trusted. Change all three together, and only if the subnet collides with another network.
# MAILME_PROXY_SUBNET=172.30.0.0/24
# MAILME_PROXY_RANGE=172.30.0.0/25
# MAILME_CADDY_IP=172.30.0.250

# Which reverse proxies may set X-Forwarded-For — request.ip keys every per-IP rate limit (login, TOTP, probes, ingest,
# one-click) and the audit IPs. "loopback" (a proxy on the same machine), "true" (trust any hop — only if nothing
# else can reach the port), or comma-separated CIDRs of the proxy's network. Wrong here = either every client shares
# one bucket (proxy not trusted: one attacker locks everyone out) or clients can spoof their IP (too much trusted).
# Docker: set by docker-compose.yml to MAILME_CADDY_IP; this line does not apply there.
TRUST_PROXY=loopback
# Never send mail from these senders to the AI: comma-separated addresses or @domain entries
DENY_LIST=
