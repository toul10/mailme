{
  "name": "mailme",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI assistant that turns your mailbox into a short task list and a daily report",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toul10/mailme.git"
  },
  "homepage": "https://github.com/toul10/mailme#readme",
  "bugs": {
    "url": "https://github.com/toul10/mailme/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/server/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start:api": "tsx src/server/main.ts",
    "start:worker": "tsx src/worker/main.ts",
    "start:tick": "tsx src/worker/main.ts --tick",
    "cli": "tsx src/cli/main.ts",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.4",
    "@fontsource-variable/jura": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.0.6",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/piazzolla": "^5.3.0",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "libqp": "2.1.3"
    }
  }
}
